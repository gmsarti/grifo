# Obrigatório — gere um valor forte com: openssl rand -hex 32
SECRET_KEY=

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/sql_app.db

# API keys
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
TAVILY_API_KEY=

# Model configuration
MODEL_PROVIDER=openai  # "openai" ou "deepseek"
MODEL_REASONER=gpt-4o
MODEL_FAST=gpt-4o-mini

# Langsmith (opcional)
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=grifo

# Chroma
CHROMA_PERSIST_DIRECTORY=./data/chroma
